# Server Port
PORT=5000

# Google Gemini API Key (Required for production AI explanations)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_key_here

# Gemini Model ID (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Maximum allowable code snippet length in characters
MAX_CODE_LENGTH=8000

# Optional mock mode for testing without an active Gemini API quota: true or false
MOCK_GEMINI=false
